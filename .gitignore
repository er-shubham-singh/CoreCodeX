# CoreCodeX Root Git Ignore

# Dependencies
node_modules/
client/node_modules/
server/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
.next/
client/.next/
out/
client/out/

# Production Builds
dist/
build/
client/build/
server/dist/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env*.local
!.env.example
!server/.env.example
!client/.env.example

# Debug and Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Settings
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# Vercel & Deployment Cache
.vercel
.cache/
.turbo/
